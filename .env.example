# =============================================================================
# Docker Manager — Environment Configuration
# =============================================================================
# Copy this to .env and fill in your values.
# The same .env file works for both development and production modes.
#   npm run dev  → NODE_ENV=development (uses dev.db, watch mode)
#   npm start    → NODE_ENV=production  (uses dockermanager.db, compiled)
# =============================================================================

# -- API Authentication (REQUIRED) -------------------------------------------
# Used for all /api/* routes. Generate one via: openssl rand -hex 32
DOCKERMANAGER_API_TOKEN=your-secret-token-here
DOCKERMANAGER_ADMIN_USER=admin
DOCKERMANAGER_ADMIN_PASSWORD=change-me
DOCKERMANAGER_OAUTH_CLIENT_ID=
DOCKERMANAGER_OAUTH_CLIENT_SECRET=

# -- Server Configuration ----------------------------------------------------
PORT=22443
DOCKERMANAGER_BACKEND_ORIGIN=http://127.0.0.1:22443
FRONTEND_PORT=22080
HOST=0.0.0.0
NODE_ENV=production

# -- Database (PostgreSQL) ---------------------------------------------------
# Local development connects to the host-mapped PostgreSQL port.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=1234
POSTGRES_USER=gautamdotdev
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=dockermanager_prod

# -- Workspace ---------------------------------------------------------------
DEFAULT_WORKSPACE_ROOT=./docker-yaml-files

# -- Ollama AI (optional) ----------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# -- Search APIs (optional) --------------------------------------------------
# Tavily Search API (https://tavily.com) — 1,000 free queries/month
TAVILY_API_KEY=tvly-your-api-key-here
# Brave Search API (https://brave.com/search/api/) — ~2,000 free queries/month
BRAVE_SEARCH_API_KEY=
# Google Custom Search API (https://developers.google.com/custom-search)
GOOGLE_API_KEY=
GOOGLE_CX=
