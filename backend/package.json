{
  "name": "dockermanager-backend-ops",
  "private": true,
  "scripts": {
    "up": "docker volume create dockermanager_prod_data && docker compose -f docker-compose.yml --env-file ../.env up -d --build",
    "down": "docker compose -f docker-compose.yml --env-file ../.env down",
    "status": "docker compose -f docker-compose.yml --env-file ../.env ps",
    "logs": "docker compose -f docker-compose.yml --env-file ../.env logs -f"
  }
}
