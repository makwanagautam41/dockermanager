generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Container {
  id        String   @id @default(uuid())
  dockerId  String   @unique
  name      String
  image     String
  status    String   @default("unknown")
  createdAt DateTime @default(now())
  
  @@index([status])
}

model YamlVersion {
  id        String   @id @default(uuid())
  content   String
  message   String?
  ts        DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(uuid())
  role      String   
  content   String   
  yaml      String?
  ts        DateTime @default(now())
}

model Snippet {
  id          String   @id @default(uuid())
  name        String
  description String?
  tags        String   @default("[]")
  yaml        String
  createdAt   DateTime @default(now())
}

model AlertRule {
  id            String   @id @default(uuid())
  name          String
  target        String
  condition     String
  window        String
  enabled       Boolean  @default(true)
  lastTriggered String?
  createdAt     DateTime @default(now())
}

model EnvFile {
  id        String   @id @default(uuid())
  path      String
  vars      String   @default("[]")
  createdAt DateTime @default(now())
}

model Activity {
  id          String   @id
  kind        String
  message     String
  ts          DateTime @default(now())

  @@index([ts])
}

model Setting {
  id    String @id
  value String @default("{}")
}

model AiSession {
  id        String   @id @default(uuid())
  name      String
  model     String   @default("")
  options   String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  messages    AiMessage[]
}

model AiMessage {
  id        String   @id @default(uuid())
  role      String
  content   String
  createdAt DateTime @default(now())

  sessionId String
  session   AiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SearchLog {
  id        String   @id @default(uuid())
  query     String
  engine    String
  results   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([engine])
  @@index([createdAt])
}

model YamlBackup {
  id        String   @id @default(uuid())
  filePath  String
  content   String
  ts        DateTime @default(now())
}