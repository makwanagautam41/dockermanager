FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY client/package*.json ./client/
RUN npm ci
RUN cd client && npm ci

COPY . .

# Build the frontend (Vite builds into client/.output/public or client/dist)
# According to the Vite config and app module, the path is client/.output/public
RUN npm run build:frontend

FROM nginx:alpine

# Copy the build output to replace the default nginx contents
COPY --from=builder /app/client/.output/public /usr/share/nginx/html

# Copy the custom nginx configuration
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
