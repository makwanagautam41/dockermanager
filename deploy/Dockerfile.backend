FROM node:22-alpine AS builder

WORKDIR /app

# Install build tools needed by dependencies during the image build.
RUN apk add --no-cache python3 make g++

COPY package*.json ./
RUN npm ci

COPY . .

# Generate Prisma client and build only the backend API.
RUN npm run db:generate
RUN npx nest build

FROM node:22-alpine

WORKDIR /app

# Docker CLI + Compose v2 plugin so the backend can run `docker compose` via the mounted docker.sock
RUN apk add --no-cache docker-cli docker-cli-compose

# Copy built artifacts and dependencies
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.ts ./prisma.config.ts

# Ensure the YAML workspace directory exists in the image (host mount overrides it)
RUN mkdir -p /app/docker-yaml-files

EXPOSE 22443

CMD ["sh", "-c", "npx prisma db push && npm run start:prod"]
